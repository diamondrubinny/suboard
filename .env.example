# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# SQLite file (keep outside the web root; back it up regularly).
DATABASE_PATH=./data/suboard.db

# Public origin(s) the browser uses, comma-separated (CSRF Origin check).
APP_ORIGIN=https://safety.example.org

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_IP_SECRET=

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Brute-force protection
LOGIN_MAX_PER_WINDOW=10
LOGIN_WINDOW_MINUTES=15
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Number of reverse proxies in front of the app (1 for nginx/IIS). 0 = direct.
TRUST_PROXY_HOPS=1

AUDIT_RETENTION_DAYS=365
TIME_ZONE=Asia/Jerusalem
LOG_LEVEL=info
# COOKIE_SECURE defaults to true in production.
# STATIC_DIR=/opt/suboard/apps/web/dist

# ---------- Phase 2 ----------
# MFA: 32-byte key that encrypts TOTP secrets at rest. REQUIRED in production. Back it up securely:
# losing it means every user must re-enrol MFA. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
# Roles that must use MFA (comma-separated: admin,manager,member). Empty = optional for all.
MFA_REQUIRED_ROLES=admin
MFA_ISSUER=SUBoard

# Public URL used in e-mail links (defaults to the first APP_ORIGIN).
# PUBLIC_URL=https://safety.example.org

# E-mail (optional). Without SMTP_HOST, e-mail is off; in-app notifications still work.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465 (implicit TLS); otherwise STARTTLS is required
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=SUBoard <no-reply@example.org>
# Local hour (TIME_ZONE) after which daily jobs run: reminders, scheduled automations (date / SLA) and scheduled reports.
DIGEST_HOUR=7
NOTIFICATION_RETENTION_DAYS=90

# Attachments: stored outside the web root. Files stay quarantined until ClamAV reports clean.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# CLAMAV_SOCKET=/run/clamav/clamd.ctl   # alternative to host/port
CLAMAV_TIMEOUT_MS=30000
# DEVELOPMENT ONLY (rejected in production): CLAMAV_SCAN_DISABLED_UNSAFE=true

# ---- Organisational sign-in (SSO, OpenID Connect — Microsoft Entra ID or any OIDC provider)
# All three enable SSO. Redirect URI to register at the IdP: <PUBLIC_URL>/api/auth/sso/callback
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# SSO_LABEL=התחברות ארגונית
# Create member accounts on first SSO login (default false: users must exist or come from SCIM)
# SSO_JIT_PROVISIONING=false
# SSO_ALLOWED_DOMAINS=example.org
# Treat SSO logins as MFA (set true when Conditional Access enforces MFA for this app)
# SSO_TRUST_IDP_MFA=false
# Password login: enabled (default) | admins_only (break-glass) | disabled. Restricting requires SSO.
LOCAL_LOGIN=enabled
# ---- SCIM 2.0 provisioning (Tenant URL: <PUBLIC_URL>/scim/v2). Min 32 random characters; unset = off.
# SCIM_TOKEN=

# --- Serving under a folder of an existing site (e.g. https://dreadlist.com/test) ---
# PUBLIC_URL includes the folder; APP_ORIGIN stays the bare origin (https://dreadlist.com).
# Build the web app with the same folder:  VITE_BASE_PATH=/test/ npm run build
# PUBLIC_URL=https://dreadlist.com/test
# Test / staging sites: X-Robots-Tag noindex on every response (remove in production).
# NOINDEX=true
